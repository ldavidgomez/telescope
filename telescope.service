[Unit]
Description=Stellarium telescope server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=astro
Group=astro
SupplementaryGroups=i2c dialout
WorkingDirectory=/home/astro/telescope
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'for attempt in $(seq 1 30); do [ -e /dev/i2c-1 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /home/astro/telescope/stellarium_server.py --config /home/astro/telescope/telescope_config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
