<globals>
	<api />

	<consts>
		<color name="night_bg" value="0x080000" />
		<color name="night_panel" value="0x160000" />
		<color name="night_border" value="0x5E1010" />
		<color name="night_text" value="0xFF5A4F" />
		<color name="night_muted" value="0xB12B26" />
		<color name="night_accent" value="0xFF2D20" />

		<color name="day_bg" value="0x0C1720" />
		<color name="day_panel" value="0x172935" />
		<color name="day_border" value="0x315568" />
		<color name="day_text" value="0xEAF7FF" />
		<color name="day_muted" value="0x91ADBC" />
		<color name="day_accent" value="0x4DD5FF" />
		<color name="brightness_mask" value="0x000000" />
	</consts>

	<fonts>
		<bin name="font_small" src_path="fonts/Montserrat-Regular.ttf" size="12" bpp="2" range="0x20-0x7F" as_file="false" />
		<bin name="font_body" src_path="fonts/Montserrat-Regular.ttf" size="16" bpp="2" range="0x20-0x7F" as_file="false" />
		<bin name="font_heading" src_path="fonts/Montserrat-SemiBold.ttf" size="20" bpp="2" range="0x20-0x7F" as_file="false" />
		<bin name="font_value" src_path="fonts/Montserrat-SemiBold.ttf" size="28" bpp="2" range="0x20-0x7F" as_file="false" />
	</fonts>

	<styles>
		<style name="screen_night" bg_color="#night_bg" bg_opa="100%" text_color="#night_text" text_font="font_body" pad_all="0" />
		<style name="screen_day" bg_color="#day_bg" bg_opa="100%" text_color="#day_text" text_font="font_body" pad_all="0" />

		<style name="panel_night" bg_color="#night_panel" bg_opa="100%" border_color="#night_border" border_width="1" radius="10" pad_all="10" />
		<style name="panel_day" bg_color="#day_panel" bg_opa="100%" border_color="#day_border" border_width="1" radius="10" pad_all="10" />

		<style name="muted_night" text_color="#night_muted" />
		<style name="muted_day" text_color="#day_muted" />
		<style name="accent_night" text_color="#night_accent" />
		<style name="accent_day" text_color="#day_accent" />
		<style name="value_night" text_color="#night_text" />
		<style name="value_day" text_color="#day_text" />

		<style name="button_night" bg_color="#night_panel" bg_opa="100%" border_color="#night_border" border_width="1" radius="8" text_color="#night_text" />
		<style name="button_day" bg_color="#day_panel" bg_opa="100%" border_color="#day_border" border_width="1" radius="8" text_color="#day_text" />
		<style name="guide_night" bg_color="#night_panel" bg_opa="100%" border_color="#night_accent" border_width="1" radius="10" pad_all="8" />
		<style name="guide_day" bg_color="#day_panel" bg_opa="100%" border_color="#day_accent" border_width="1" radius="10" pad_all="8" />
		<style name="transparent" bg_opa="0%" border_width="0" pad_all="0" />
		<style name="reticle_night" bg_opa="0%" border_color="#night_border" border_width="2" radius="100" />
		<style name="reticle_day" bg_opa="0%" border_color="#day_border" border_width="2" radius="100" />
		<style name="axis_night" bg_color="#night_border" bg_opa="100%" border_width="0" radius="1" />
		<style name="axis_day" bg_color="#day_border" bg_opa="100%" border_width="0" radius="1" />
		<style name="vector_night" bg_color="#night_accent" bg_opa="100%" border_width="0" radius="3" text_color="#night_accent" />
		<style name="vector_day" bg_color="#day_accent" bg_opa="100%" border_width="0" radius="3" text_color="#day_accent" />
		<style name="vector_dot_night" bg_color="#night_accent" bg_opa="100%" border_width="0" radius="100" />
		<style name="vector_dot_day" bg_color="#day_accent" bg_opa="100%" border_width="0" radius="100" />
		<style name="vector_line_pivot" transform_pivot_x="0" transform_pivot_y="2" />
		<style name="vector_angle_e" transform_rotation="0" />
		<style name="vector_angle_se" transform_rotation="450" />
		<style name="vector_angle_s" transform_rotation="900" />
		<style name="vector_angle_sw" transform_rotation="1350" />
		<style name="vector_angle_w" transform_rotation="1800" />
		<style name="vector_angle_nw" transform_rotation="2250" />
		<style name="vector_angle_n" transform_rotation="2700" />
		<style name="vector_angle_ne" transform_rotation="3150" />
		<style name="vector_coarse" transform_scale_x="256" transform_scale_y="256" />
		<style name="vector_fine" transform_scale_x="176" transform_scale_y="176" />
		<style name="vector_aligned" opa="0%" />
		<style name="state_hidden" opa="0%" />
		<style name="state_visible" opa="100%" />

		<!-- The desktop preview cannot change a physical backlight. These styles
		     simulate brightness with a non-interactive black overlay. -->
		<style name="brightness_10" bg_color="#brightness_mask" bg_opa="80%" border_width="0" radius="0" />
		<style name="brightness_20" bg_color="#brightness_mask" bg_opa="68%" border_width="0" radius="0" />
		<style name="brightness_30" bg_color="#brightness_mask" bg_opa="56%" border_width="0" radius="0" />
		<style name="brightness_40" bg_color="#brightness_mask" bg_opa="45%" border_width="0" radius="0" />
		<style name="brightness_50" bg_color="#brightness_mask" bg_opa="35%" border_width="0" radius="0" />
		<style name="brightness_60" bg_color="#brightness_mask" bg_opa="26%" border_width="0" radius="0" />
		<style name="brightness_70" bg_color="#brightness_mask" bg_opa="18%" border_width="0" radius="0" />
		<style name="brightness_80" bg_color="#brightness_mask" bg_opa="11%" border_width="0" radius="0" />
		<style name="brightness_90" bg_color="#brightness_mask" bg_opa="5%" border_width="0" radius="0" />
		<style name="brightness_100" bg_color="#brightness_mask" bg_opa="0%" border_width="0" radius="0" />
	</styles>

	<subjects>
		<int name="night_mode" value="1" min_value="0" max_value="1" help="0 = day, 1 = night" />
		<int name="brightness" value="80" min_value="10" max_value="100" />
		<string name="target_name" value="ALDEBARAN" />
		<string name="current_az" value="052.0" />
		<string name="current_alt" value="+18.0" />
		<string name="target_az" value="067.4" />
		<string name="target_alt" value="+31.8" />
		<string name="az_direction" value="&gt;" />
		<string name="alt_direction" value="^" />
		<string name="az_error" value="+15.4 deg" />
		<string name="alt_error" value="+13.8 deg" />
		<int name="guide_sector" value="7" min_value="0" max_value="7" help="0 E, 1 SE, 2 S, 3 SW, 4 W, 5 NW, 6 N, 7 NE" />
		<int name="guide_stage" value="0" min_value="0" max_value="2" help="0 coarse, 1 fine, 2 aligned" />
		<string name="guide_status" value="COARSE" />
		<string name="connection_status" value="STELLARIUM  OK   IMU  OK   PI  OK" />
	</subjects>
</globals>
