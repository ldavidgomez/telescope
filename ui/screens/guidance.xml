<screen permanent="true">
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="screen_night" />
		<bind_style name="screen_day" subject="night_mode" ref_value="0" />

		<lv_label x="14" y="8" bind_text="target_name" style_text_font="font_heading" />
		<lv_label x="374" y="10" bind_text="guide_status">
			<style name="accent_night" />
			<bind_style name="accent_day" subject="night_mode" ref_value="0" />
		</lv_label>

		<lv_obj x="12" y="40" width="222" height="160" scrollable="false">
			<style name="panel_night" />
			<bind_style name="panel_day" subject="night_mode" ref_value="0" />
			<lv_label x="0" y="0" text="CURRENT POSITION">
				<style name="muted_night" />
				<bind_style name="muted_day" subject="night_mode" ref_value="0" />
			</lv_label>
			<lv_label x="0" y="38" text="AZ" style_text_font="font_heading" />
			<lv_label x="52" y="31" bind_text="current_az" style_text_font="font_value" />
			<lv_label x="0" y="99" text="ALT" style_text_font="font_heading" />
			<lv_label x="52" y="92" bind_text="current_alt" style_text_font="font_value" />
		</lv_obj>

		<lv_obj x="246" y="40" width="222" height="160" scrollable="false">
			<style name="panel_night" />
			<bind_style name="panel_day" subject="night_mode" ref_value="0" />
			<lv_label x="0" y="0" text="MOVE TELESCOPE">
				<style name="muted_night" />
				<bind_style name="muted_day" subject="night_mode" ref_value="0" />
			</lv_label>
			<lv_label x="2" y="29" bind_text="az_direction" style_text_font="font_arrow">
				<style name="accent_night" />
				<bind_style name="accent_day" subject="night_mode" ref_value="0" />
			</lv_label>
			<lv_label x="50" y="32" text="AZ" style_text_font="font_heading" />
			<lv_label x="90" y="27" bind_text="az_error" style_text_font="font_heading" />
			<lv_label x="2" y="91" bind_text="alt_direction" style_text_font="font_arrow">
				<style name="accent_night" />
				<bind_style name="accent_day" subject="night_mode" ref_value="0" />
			</lv_label>
			<lv_label x="50" y="94" text="ALT" style_text_font="font_heading" />
			<lv_label x="90" y="89" bind_text="alt_error" style_text_font="font_heading" />
		</lv_obj>

		<lv_label x="16" y="211" text="TARGET">
			<style name="muted_night" />
			<bind_style name="muted_day" subject="night_mode" ref_value="0" />
		</lv_label>
		<lv_label x="88" y="211" text="AZ" />
		<lv_label x="112" y="211" bind_text="target_az" />
		<lv_label x="192" y="211" text="ALT" />
		<lv_label x="226" y="211" bind_text="target_alt" />
		<lv_label x="16" y="238" bind_text="connection_status">
			<style name="muted_night" />
			<bind_style name="muted_day" subject="night_mode" ref_value="0" />
		</lv_label>

		<lv_button x="12" y="274" width="112" height="36">
			<style name="button_night" />
			<bind_style name="button_day" subject="night_mode" ref_value="0" />
			<subject_increment_event trigger="clicked" subject="brightness" step="-10" min_value="5" max_value="100" />
			<lv_label align="center" text="BRIGHT -" />
		</lv_button>

		<lv_button x="134" y="274" width="212" height="36">
			<style name="button_night" />
			<bind_style name="button_day" subject="night_mode" ref_value="0" />
			<subject_increment_event trigger="clicked" subject="night_mode" step="1" min_value="0" max_value="1" rollover="true" />
			<lv_label x="16" align="left_mid" text="DAY / NIGHT" />
			<lv_label x="154" align="right_mid" bind_text="brightness" bind_text-fmt="%d%%" />
		</lv_button>

		<lv_button x="356" y="274" width="112" height="36">
			<style name="button_night" />
			<bind_style name="button_day" subject="night_mode" ref_value="0" />
			<subject_increment_event trigger="clicked" subject="brightness" step="10" min_value="5" max_value="100" />
			<lv_label align="center" text="BRIGHT +" />
		</lv_button>
	</view>
</screen>
